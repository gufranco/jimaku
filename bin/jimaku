#!/bin/sh
[ -n "${ZSH_VERSION:-}" ] && emulate sh

for jm_inherited in $(env | sed -n 's/^\(JM_[A-Za-z0-9_]*\)=.*/\1/p'); do
  unset "${jm_inherited}"
done

jm_self="$0"
case "${jm_self}" in
*/*) ;;
*) jm_self="$(command -v -- "${jm_self}")" ;;
esac
JM_LIB="$(cd "${jm_self%/*}/../lib" && pwd)" || exit 1

# shellcheck source=SCRIPTDIR/../lib/core.sh
. "${JM_LIB}/core.sh"
# shellcheck source=SCRIPTDIR/../lib/ui.sh
. "${JM_LIB}/ui.sh"
# shellcheck source=SCRIPTDIR/../lib/cli.sh
. "${JM_LIB}/cli.sh"
# shellcheck source=SCRIPTDIR/../lib/doctor.sh
. "${JM_LIB}/doctor.sh"
# shellcheck source=SCRIPTDIR/../lib/language.sh
. "${JM_LIB}/language.sh"
# shellcheck source=SCRIPTDIR/../lib/args.sh
. "${JM_LIB}/args.sh"
# shellcheck source=SCRIPTDIR/../lib/videos.sh
. "${JM_LIB}/videos.sh"
# shellcheck source=SCRIPTDIR/../lib/utf8.sh
. "${JM_LIB}/utf8.sh"
# shellcheck source=SCRIPTDIR/../lib/fetch.sh
. "${JM_LIB}/fetch.sh"
# shellcheck source=SCRIPTDIR/../lib/run.sh
. "${JM_LIB}/run.sh"

jm_main() {
  jm_mn_count=$#
  jm_mn_literal=no
  while [ "${jm_mn_count}" -gt 0 ]; do
    jm_mn_arg="$1"
    shift
    jm_mn_count=$((jm_mn_count - 1))
    case "${jm_mn_literal}:${jm_mn_arg}" in
    no:--) jm_mn_literal=yes ;;
    no:--theme=*)
      JM_THEME="${jm_mn_arg#--theme=}"
      continue
      ;;
    no:--theme)
      [ "${jm_mn_count}" -gt 0 ] || jm_main_stop "option '--theme' needs a value"
      JM_THEME="$1"
      shift
      jm_mn_count=$((jm_mn_count - 1))
      continue
      ;;
    *) ;;
    esac
    set -- "$@" "${jm_mn_arg}"
  done
  jm_ui_setup || jm_main_fail "${JM_UI_PROBLEM}"
  jm_dispatch "$@"
}

jm_main_stop() {
  jm_cli_hint "$1"
  exit 1
}

jm_main_fail() {
  jm_error "$1"
  exit 1
}

jm_dispatch() {
  case "${1:-}" in
  help | -h | --help) jm_usage ;;
  version | -V | --version) jm_cli_version ;;
  doctor) jm_doctor ;;
  *) jm_start "$@" ;;
  esac
}

jm_main "$@"
